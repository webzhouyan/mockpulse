{
  "name": "mockpulse",
  "private": true,
  "version": "1.0.2",
  "author": {
    "name": "webzhouyan",
    "email": "zhouyan_9999@126.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webzhouyan/mockpulse.git"
  },
  "bugs": {
    "url": "https://github.com/webzhouyan/mockpulse/issues"
  },
  "prettier": {
    "singleQuote": true,
    "tabWidth": 2,
    "printWidth": 80,
    "trailingComma": "none",
    "endOfLine": "auto"
  },
  "scripts": {
    "lint": "npm run lint --workspaces",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "set-versions": "node ./scripts/set-versions.mjs && npm install",
    "build:commons": "npm run build --workspace=@mockoon/commons",
    "build:commons:watch": "npm run build:watch --workspace=@mockoon/commons",
    "build:commons-server": "npm run build --workspace=@mockoon/commons-server",
    "build:commons-server:watch": "npm run build:watch --workspace=@mockoon/commons-server",
    "build:libs": "npm run build --workspace=@mockoon/commons --workspace=@mockoon/commons-server",
    "build:libs:watch": "concurrently \"npm run build:watch --workspace=@mockoon/commons\" \"npm run build:watch --workspace=@mockoon/commons-server\"",
    "build:desktop:dev:watch": "npm run build:watch:all --workspace=@mockpulse/app",
    "build:desktop:dev": "npm run build:dev:all --workspace=@mockpulse/app",
    "build:desktop:prod": "npm run build:prod:all --workspace=@mockpulse/app",
    "start:desktop:dev": "npm run start --workspace=@mockpulse/app",
    "start:desktop:dev:2": "npm run start:2 --workspace=@mockpulse/app",
    "start:desktop:dev:3": "npm run start:3 --workspace=@mockpulse/app",
    "test:commons": "npm run test --workspace=@mockoon/commons",
    "test:commons-server": "npm run test --workspace=@mockoon/commons-server",
    "test:libs": "npm run test --workspace=@mockoon/commons --workspace=@mockoon/commons-server",
    "package:desktop:win": "npm run package:win --workspace=@mockpulse/app",
    "package:desktop:win:appx": "npm run package:win:appx --workspace=@mockpulse/app",
    "package:desktop:mac": "npm run package:mac --workspace=@mockpulse/app",
    "package:desktop:mac:unsigned": "npm run package:mac:unsigned --workspace=@mockpulse/app",
    "package:desktop:mac:arm64": "npm run package:mac:arm64 --workspace=@mockpulse/app",
    "package:desktop:linux": "npm run package:linux --workspace=@mockpulse/app"
  },
  "workspaces": [
    "packages/app",
    "packages/commons",
    "packages/commons-server"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "glob": "13.0.6",
    "glob-bin": "1.1.0",
    "prettier": "3.9.8",
    "prettier-plugin-organize-imports": "4.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true
  }
}
